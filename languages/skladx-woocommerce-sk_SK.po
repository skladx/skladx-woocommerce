#. Plugin Name of the plugin
#: skladx-woocommerce.php
msgid "SkladX for WooCommerce"
msgstr "SkladX pre WooCommerce"

#. Plugin URI of the plugin
#: skladx-woocommerce.php
msgid "https://github.com/skladx/skladx-woocommerce"
msgstr ""

#. Description of the plugin
#: skladx-woocommerce.php
msgid "Connects WooCommerce with the SkladX fulfilment warehouse: exports orders, syncs products and stock, and receives order status and tracking updates via signed webhooks."
msgstr "Prepojí WooCommerce s fulfillmentovým skladom SkladX: odosiela objednávky, synchronizuje produkty a zásoby a cez podpísané webhooky prijíma stavy objednávok a sledovanie zásielok."

#. Author of the plugin
#: skladx-woocommerce.php
msgid "SkladX"
msgstr ""

#. Author URI of the plugin
#: skladx-woocommerce.php
msgid "https://github.com/skladx"
msgstr ""

